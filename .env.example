# ForgeAI environment configuration
# Copy this file to .env and fill in the values. Never commit .env.

# --- Database ---------------------------------------------------------------
# JDBC URL used by the backend when it runs on your machine.
# (Docker Compose overrides the host to "postgres" for the backend container.)
DATABASE_URL=jdbc:postgresql://localhost:5432/forgeai
DATABASE_USERNAME=forgeai
DATABASE_PASSWORD=change-me

# Optional: database name and host ports used by docker-compose.yml
POSTGRES_DB=forgeai
POSTGRES_PORT=5432
BACKEND_PORT=8080
FRONTEND_PORT=3000

# --- AI ---------------------------------------------------------------------
# Claude API key. Not used until the AI module is introduced (Phase 3).
CLAUDE_API_KEY=

# --- Security ---------------------------------------------------------------
# Secret for signing JWTs. Not used until authentication is introduced (Phase 2).
# Generate one with: openssl rand -base64 48
JWT_SECRET=
