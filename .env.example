# ForgeAI environment configuration
# Copy this file to .env and fill in the values. Never commit .env.

# --- Database ---------------------------------------------------------------
# JDBC URL used by the backend when it runs on your machine.
# (Docker Compose overrides the host to "postgres" for the backend container.)
DATABASE_URL=jdbc:postgresql://localhost:5432/forgeai
DATABASE_USERNAME=forgeai
DATABASE_PASSWORD=change-me

# Optional: database name and host ports used by docker-compose.yml
POSTGRES_DB=forgeai
POSTGRES_PORT=5432
BACKEND_PORT=8080
FRONTEND_PORT=3000

# --- AI ---------------------------------------------------------------------
# Which provider answers AI requests: claude (default) or gemini.
# Without the selected provider's key the app works, but AI features report "not configured".
AI_PROVIDER=claude

# Anthropic Claude — key from https://console.anthropic.com (paid, pay-as-you-go).
CLAUDE_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5

# Google Gemini — key from https://aistudio.google.com (free tier for Flash models;
# on the free tier Google may use prompts and responses to improve its products).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# --- Security ---------------------------------------------------------------
# Secret for signing access tokens (HS256). Required, at least 32 characters.
# Generate one with:
#   PowerShell:  [Convert]::ToBase64String([Security.Cryptography.RandomNumberGenerator]::GetBytes(48))
#   bash:        openssl rand -base64 48
JWT_SECRET=
# How long an access token stays valid (ISO-8601 duration). Default: 8 hours.
JWT_EXPIRATION=PT8H
